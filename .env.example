# AWS Configuration
AWS_ACCOUNT_ID=
DEFAULT_AWS_REGION=us-west-2

# Project Configuration
PROJECT_NAME=twin

# Backend (local) — uses Amazon Bedrock via AWS credentials (no OpenAI key)
