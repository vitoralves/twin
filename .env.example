MEMORY_DIR=../memory
CORS_ORIGINS=http://localhost:3000
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
DAILY_CHAT_LIMIT=5
RATE_LIMIT_TABLE=
MAX_MESSAGE_LENGTH=1000
